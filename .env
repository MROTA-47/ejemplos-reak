.carrito-container {
  padding: 80px 40px;
  min-height: 100vh;
  background: #f4f4f4;
  text-align: center;
}

.carrito-container h2 {
  font-size: 36px;
  margin-bottom: 40px;
}

.carrito-card {
  background: white;
  width: 420px;
  margin: 20px auto;
  padding: 25px;
  border-radius: 15px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.carrito-card h3 {
  margin-bottom: 10px;
}

.btn-eliminar {
  margin-top: 15px;
  padding: 8px 15px;
  border: none;
  border-radius: 8px;
  background: crimson;
  color: white;
  cursor: pointer;
  transition: 0.3s;
}

.btn-eliminar:hover {
  background: darkred;
}

.total {
  margin-top: 40px;
  font-size: 24px;
  font-weight: bold;
}

.vacio {
  font-size: 20px;
  color: gray;
}